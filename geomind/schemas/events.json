{
  "$defs": {
    "Message": {
      "additionalProperties": false,
      "description": "One message of a conversation.",
      "properties": {
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "description": "One fixed choice of a question: ``value`` is the answer, ``label`` what the user reads.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "One call a model asks for; ``id`` comes from the model and pairs the result with it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "default": {},
          "title": "Input",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Tokens and cost; ``a + b`` adds them up.\n\n``cached_tokens`` are the input tokens read from the provider's prompt cache, part of\n``input_tokens``.",
      "properties": {
        "cached_tokens": {
          "default": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "cost": {
          "default": 0.0,
          "title": "Cost",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "events": {
    "request": {
