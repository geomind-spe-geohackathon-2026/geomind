{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "A value the work relies on, and where it came from.\n\n``reason`` says why a value was chosen; ``citation`` holds the details of a published source,\nsuch as ``title``, ``publisher``, ``year``, ``price_year``, ``currency``, ``page`` or ``link``\nand a ``note``, so the explainer and the export can show them.",
      "properties": {
        "citation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source": {
          "default": "agent",
          "enum": [
            "user",
            "agent",
            "default"
          ],
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Calculation": {
      "additionalProperties": false,
      "description": "A derived value ``calculate`` stored: its result, the expression and every operand's source.\n\n``operands`` holds, per operand, the reference given, its value and unit, and its ``source``\n(the case path, the catalogue row with its citation, the approved assumption, the stored result\nor the earlier calculation), so the report can cite the chain.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "operands": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Operands",
          "type": "array"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label",
        "operation",
        "expression",
        "value",
        "unit"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "Compaction": {
      "additionalProperties": false,
      "description": "The summary of the first ``turns`` turns of a chat's history.",
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "turns": {
          "title": "Turns",
          "type": "integer"
        }
      },
      "required": [
        "summary",
        "turns"
      ],
      "title": "Compaction",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A teammate's whole answer, kept by reference so a later run never asks it again (QA-047).\n\nThe engine records one when a nested agent answers (``Delegate``): ``agent`` is the tool name,\n``task`` the brief's start, ``summary`` the answer's start and ``reference`` the chat artifact\n(``finding-...``) that ``read_stored`` reads whole.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent",
        "task",
        "summary",
        "reference"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "description": "An open question for the user.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "A criterion of the task, in the user's words.\n\nA numeric one is a requirement of the case (``set_case``), and ``case_requirement`` names it by\nits ``name``; gemini judges it, the text is never parsed.",
      "properties": {
        "case_requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Requirement"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "default": "open",
          "title": "Status",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "description": "A finding; ``reference`` names the stored full data.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "title": "Result",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The notes of one chat; ``version`` is raised by one with every change.\n\nNOTE: the state is frozen, so a change is always a new state and the only writer is ``apply`` of\nthe engine, over events. ``preferences`` are what the user said about how they work, such as\nthe units they read, set from the coordinator's route. ``case_origin`` is ``{case, files}``,\nthe case the user or the project\ngave, which ``set_case`` writes and verification compares the case with. NOTE: ``compaction``\nis kept here because ``save_state`` is the only\nper-chat storage of the contract, and ``load_history`` always returns every message. It is no\nkey of the document: a patch cannot reach it and ``render`` does not show it.",
  "properties": {
    "assumptions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "calculations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Calculation"
      },
      "title": "Calculations",
      "type": "array"
    },
    "case": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case"
    },
    "case_origin": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Origin"
    },
    "compaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Compaction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "design": {
      "additionalProperties": true,
      "default": {},
      "title": "Design",
      "type": "object"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "goal": {
      "default": "",
      "title": "Goal",
      "type": "string"
    },
    "preferences": {
      "additionalProperties": true,
      "default": {},
      "title": "Preferences",
      "type": "object"
    },
    "questions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Result"
      },
      "title": "Results",
      "type": "array"
    },
    "verification": {
      "additionalProperties": true,
      "default": {},
      "title": "Verification",
      "type": "object"
    },
    "version": {
      "default": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "title": "ProblemState",
  "type": "object"
}
