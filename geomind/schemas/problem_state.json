{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "A value the work relies on, and where it came from.",
      "properties": {
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "default": "agent",
          "enum": [
            "user",
            "agent",
            "default"
          ],
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Compaction": {
      "additionalProperties": false,
      "description": "The summary of the first ``turns`` turns of a chat's history.",
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "turns": {
          "title": "Turns",
          "type": "integer"
        }
      },
      "required": [
        "summary",
        "turns"
      ],
      "title": "Compaction",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "description": "An open question for the user.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "A testable criterion of the task.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "status": {
          "default": "open",
          "title": "Status",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "description": "A finding; ``reference`` names the stored full data.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "title": "Result",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The notes of one chat; ``version`` is raised by one with every change.\n\nNOTE: the state is frozen, so a change is always a new state and the only writer is ``apply`` of\nthe engine, over events. NOTE: ``compaction`` is kept here because ``save_state`` is the only\nper-chat storage of the contract, and ``load_history`` always returns every message. It is no\nkey of the document: a patch cannot reach it and ``render`` does not show it.",
  "properties": {
    "assumptions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "case": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case"
    },
    "compaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Compaction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "design": {
      "additionalProperties": true,
      "default": {},
      "title": "Design",
      "type": "object"
    },
    "goal": {
      "default": "",
      "title": "Goal",
      "type": "string"
    },
    "questions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Result"
      },
      "title": "Results",
      "type": "array"
    },
    "verification": {
      "additionalProperties": true,
      "default": {},
      "title": "Verification",
      "type": "object"
    },
    "version": {
      "default": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "title": "ProblemState",
  "type": "object"
}
