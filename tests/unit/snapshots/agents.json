    "eval_task": {
      "$defs": {
        "AnswerRule": {
          "additionalProperties": false,
          "description": "A user's answer by rule: the first rule whose ``match`` (a regex) is in the question.\n\nFor a question with options, ``answer`` must be one of their values; ``only_options`` keeps\na rule off the questions that ask for typed text.",
          "properties": {
            "answer": {
              "title": "Answer",
              "type": "string"
            },
            "match": {
              "title": "Match",
              "type": "string"
            },
            "only_options": {
              "default": false,
              "title": "Only Options",
              "type": "boolean"
            }
          },
          "required": [
            "match",
            "answer"
          ],
          "title": "AnswerRule",
          "type": "object"
        },
        "BeforeCriterion": {
          "additionalProperties": false,
          "description": "``tool`` was called before the first call of ``then``; a run without ``then`` passes.\n\nThe order of the run's own tool results, so a search comes before the question it spares.",
          "properties": {
            "kind": {
              "const": "before",
              "title": "Kind",
              "type": "string"
            },
            "then": {
              "title": "Then",
              "type": "string"
            },
            "tool": {
              "title": "Tool",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tool",
            "then"
          ],
          "title": "BeforeCriterion",
          "type": "object"
        },
        "Message": {
          "additionalProperties": false,
          "description": "One message of a conversation.",
          "properties": {
            "content": {
              "default": "",
              "title": "Content",
              "type": "string"
            },
            "role": {
              "enum": [
                "user",
                "assistant",
                "tool",
                "system"
              ],
              "title": "Role",
              "type": "string"
            },
            "tool_call_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Tool Call Id"
            },
            "tool_calls": {
              "default": [],
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "title": "Tool Calls",
              "type": "array"
            }
          },
          "required": [
            "role"
          ],
          "title": "Message",
          "type": "object"
        },
        "NumberCriterion": {
          "additionalProperties": false,
          "description": "The answer holds a number within ``tolerance`` of ``value``, in ``unit`` if one is given.",
          "properties": {
            "kind": {
              "const": "number",
              "title": "Kind",
              "type": "string"
            },
            "tolerance": {
              "title": "Tolerance",
              "type": "number"
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Unit"
            },
            "value": {
              "title": "Value",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value",
            "tolerance"
          ],
          "title": "NumberCriterion",
          "type": "object"
        },
        "QuestionCriterion": {
          "additionalProperties": false,
          "description": "The agent asked the user a question holding ``contains``.",
          "properties": {
            "contains": {
              "title": "Contains",
              "type": "string"
            },
            "kind": {
              "const": "question",
              "title": "Kind",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "contains"
          ],
          "title": "QuestionCriterion",
          "type": "object"
        },
        "SetupCall": {
          "additionalProperties": false,
          "description": "One tool call run by code before the task's agent, so the task starts from a fixed state.",
          "properties": {
            "input": {
              "additionalProperties": true,
              "default": {},
              "title": "Input",
              "type": "object"
            },
            "tool": {
              "title": "Tool",
              "type": "string"
            }
          },
          "required": [
            "tool"
          ],
          "title": "SetupCall",
          "type": "object"
        },
        "SourcedCriterion": {
          "additionalProperties": false,
          "description": "Every number of the answer and the questions is one the agent read: the agent computed none.\n\nWhat the agent read is every message it was sent that it did not write itself: the prompt,\nthe user's messages and answers, and the tools' results. A whole number up to ``small``\ncounts things or numbers a list, so it needs no source.",
          "properties": {
            "kind": {
              "const": "sourced",
              "title": "Kind",
              "type": "string"
            },
            "small": {
              "title": "Small",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "small"
          ],
          "title": "SourcedCriterion",
          "type": "object"
        },
        "StateCriterion": {
          "additionalProperties": false,
          "description": "A field of the final problem state is set, to ``equals`` if given.\n\n``path`` is a JSON Pointer, by id in lists.",
          "properties": {
            "equals": {
              "default": null,
              "title": "Equals"
            },
            "kind": {
              "const": "state",
              "title": "Kind",
              "type": "string"
            },
            "path": {
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "title": "StateCriterion",
          "type": "object"
        },
        "ToolCall": {
          "additionalProperties": false,
          "description": "One call a model asks for; ``id`` comes from the model and pairs the result with it.",
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "input": {
              "additionalProperties": true,
              "default": {},
              "title": "Input",
              "type": "object"
            },
            "name": {
              "title": "Name",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "title": "ToolCall",
          "type": "object"
        },
        "ToolCriterion": {
          "additionalProperties": false,
          "description": "A tool was called, or with ``called: false`` was not.\n\nA call counts even when its result was an error. With ``succeeded: true``, at least one\ncall of the tool must have returned no error: a lead's delegate whose nested run failed\nfails it. ``succeeded`` defaults to false, the behaviour before it, so older tasks keep\ntheir meaning.",
          "properties": {
            "called": {
              "default": true,
              "title": "Called",
              "type": "boolean"
            },
            "kind": {
              "const": "tool",
              "title": "Kind",
              "type": "string"
            },
            "succeeded": {
              "default": false,
              "title": "Succeeded",
              "type": "boolean"
            },
            "tool": {
              "title": "Tool",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tool"
          ],
          "title": "ToolCriterion",
          "type": "object"
        },
        "VerifiedCriterion": {
          "additionalProperties": false,
          "description": "gemini's checks pass again on the final design and its result, on the case it ran on.\n\n``checks`` names checks that must be among them and pass, such as a limit of the case.",
          "properties": {
            "checks": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Checks",
              "type": "array"
            },
            "kind": {
              "const": "verified",
              "title": "Kind",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "VerifiedCriterion",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "One task file; ``plant`` is a project folder and ``answers`` reply to questions in order.\n\nThe folder is gemini's project layout: ``case.json``, ``economics.json``, ``data/`` and, when\nthe task starts from a plant, one file in ``plants/``. ``max_steps`` caps the steps of every\nagent of the run, for a task about a tight budget.",
      "properties": {
        "answers": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/AnswerRule"
              }
            ]
          },
          "title": "Answers",
          "type": "array"
        },
        "criteria": {
          "items": {
            "discriminator": {
              "mapping": {
                "before": "#/$defs/BeforeCriterion",
                "number": "#/$defs/NumberCriterion",
                "question": "#/$defs/QuestionCriterion",
                "sourced": "#/$defs/SourcedCriterion",
                "state": "#/$defs/StateCriterion",
                "tool": "#/$defs/ToolCriterion",
                "verified": "#/$defs/VerifiedCriterion"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NumberCriterion"
              },
              {
                "$ref": "#/$defs/ToolCriterion"
              },
              {
                "$ref": "#/$defs/QuestionCriterion"
              },
              {
                "$ref": "#/$defs/StateCriterion"
              },
              {
                "$ref": "#/$defs/VerifiedCriterion"
              },
              {
                "$ref": "#/$defs/SourcedCriterion"
              },
              {
                "$ref": "#/$defs/BeforeCriterion"
              }
            ]
          },
          "title": "Criteria",
          "type": "array"
        },
        "history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "History",
          "type": "array"
        },
        "max_steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "plant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plant"
        },
        "setup": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SetupCall"
          },
          "title": "Setup",
          "type": "array"
        }
      },
      "required": [
        "message",
        "criteria"
      ],
      "title": "Task",
      "type": "object"
    },
    "sections": [
      "Agents",
      "Prompt",
      "Tools",
      "Output",
      "Model"
    ]
  },
  "version": "0.4.22.dev53"
}
