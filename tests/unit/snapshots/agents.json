{
  "items": {
    "AGENTS": [
      "analysis_lead"
    ],
    "Agent": {
      "__call__": "(self, context)",
      "__init__": "(self)",
      "children": "(self)",
      "complete": "(self, context, messages)",
      "forward": "(self, context)",
      "help": "(cls)",
      "load_loop_state": "(self, state)",
      "named_agents": "(self)",
      "tool_schemas": "(self)",
      "tools": "(self, recurse=False)"
    },
    "LOOPS": {
      "compare": "(self, design_lead, reviewer, max_rounds=5, concurrency=None, retries=None)",
      "design": "(self, design_lead, reviewer, max_rounds=5)",
      "project": "(self, agent, max_steps=None)",
      "tool": "(self, agent, max_steps=None)"
    },
    "Model": {
      "additionalProperties": false,
      "description": "Which model an agent wants; ``name=None`` means the model its role's setting names.\n\n``setting`` names the runtime setting of an agent's role, such as ``designlead_model``, set\nby ``GEOMIND_DESIGNLEAD_MODEL``. There is no default model: a role whose setting is unset has\nno model, and a real provider refuses to call. ``fallbacks`` lists models tried in order when\nthe provider keeps failing.",
      "properties": {
        "fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "setting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setting"
        },
        "temperature": {
          "default": 0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "Model",
      "type": "object"
    },
    "Output": {
      "__init__": "(self, kind=<class 'str'>, max_retries=2)",
      "instructions": "(self)",
      "validate": "(self, answer)"
    },
    "Prompt": {
      "__init__": "(self, role, appendix=None)",
      "render": "(self)",
      "text": "(cls, content)"
    },
    "Route": {
      "additionalProperties": false,
      "description": "Where a message goes: a short direct answer, or a loop with an agent.\n\n``loop`` and ``agent`` name rows of ``LOOPS`` and ``AGENTS`` in ``run.py``, which sits to the\nright of this package, so a test keeps the two lists equal. The delegate reads the user's\nmessage itself, never a retelling of it; ``task`` is the coordinator's brief beside it, for\na message that is an event of the app (a form saved, a file added) rather than words.\n``preferences`` are what the user said about how they work, such as the units they read,\nkept in the problem state for every agent.",
      "properties": {
        "agent": {
          "const": "analysis_lead",
          "default": "analysis_lead",
          "title": "Agent",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "kind": {
          "enum": [
            "answer",
            "loop"
          ],
          "title": "Kind",
          "type": "string"
        },
        "loop": {
          "default": "tool",
          "enum": [
            "tool",
            "project",
            "design",
            "compare"
          ],
          "title": "Loop",
          "type": "string"
        },
        "preferences": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferences"
        },
        "task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Route",
      "type": "object"
    },
