{
  "items": {
    "AGENTS": [
      "analyst",
      "code_assistant"
    ],
    "Agent": {
      "__call__": "(self, context)",
      "__init__": "(self)",
      "children": "(self)",
      "complete": "(self, context, messages)",
      "forward": "(self, context)",
      "help": "(cls)",
      "load_loop_state": "(self, state)",
      "named_agents": "(self)",
      "tool_schemas": "(self)",
      "tools": "(self, recurse=False)"
    },
    "LOOPS": {
      "compare": "(self, designer, verifier, max_rounds=5, concurrency=None, retries=None)",
      "design": "(self, designer, verifier, max_rounds=5)",
      "tool": "(self, agent, max_steps=None)"
    },
    "Model": {
      "additionalProperties": false,
      "description": "Which model an agent wants; ``name=None`` means a model of ``gd.runtime``.\n\n``setting`` names the runtime setting of an agent's role, such as ``analyst_model``. Unset, or\nset to ``None``, it means the default model. ``fallbacks`` lists models tried in order when the\nprovider keeps failing.",
      "properties": {
        "fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "setting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setting"
        },
        "temperature": {
          "default": 0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "Model",
      "type": "object"
    },
    "Output": {
      "__init__": "(self, kind=<class 'str'>, max_retries=2)",
      "instructions": "(self)",
      "validate": "(self, answer)"
    },
    "Prompt": {
      "__init__": "(self, role, appendix=None)",
      "render": "(self)",
      "text": "(cls, content)"
    },
    "Route": {
      "additionalProperties": false,
      "description": "Where a message goes: a short direct answer, or a loop with an agent.\n\n``loop`` and ``agent`` name rows of ``LOOPS`` and ``AGENTS`` in ``run.py``, which sits to the\nright of this package, so a test keeps the two lists equal. The delegate reads the user's\nmessage itself, never a retelling of it.",
      "properties": {
        "agent": {
          "default": "analyst",
          "enum": [
            "analyst",
            "code_assistant"
          ],
          "title": "Agent",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "kind": {
          "enum": [
            "answer",
            "loop"
          ],
          "title": "Kind",
          "type": "string"
        },
        "loop": {
          "default": "tool",
          "enum": [
            "tool",
            "design",
            "compare"
          ],
          "title": "Loop",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Route",
      "type": "object"
    },
