{
  "items": {
    "Delegate": {
      "description": "Run ``agent`` in a nested engine run with a clean context: the task text only.",
      "effect": "compute",
      "idempotent": false,
      "input_schema": {
        "additionalProperties": false,
        "description": "What the model passes: the task text.",
        "properties": {
          "task": {
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "title": "DelegateInput",
        "type": "object"
      },
      "late_schemas": [],
      "name": "Delegate"
    },
    "ask_user": {
      "description": "Ask the user a question and wait for the answer, with fixed options if there are any.",
      "effect": "read",
      "idempotent": true,
      "input_schema": {
        "$defs": {
          "Option": {
            "additionalProperties": false,
            "description": "One fixed choice of a question: ``value`` is the answer, ``label`` what the user reads.",
            "properties": {
              "label": {
                "title": "Label",
                "type": "string"
              },
              "value": {
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "title": "Option",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "options": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/Option"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Options"
          },
          "question": {
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "ask_user_input",
        "type": "object"
      },
      "late_schemas": [],
      "name": "ask_user"
    },
