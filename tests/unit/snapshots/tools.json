    "Delegate": {
      "description": "Run ``agent`` in a nested engine run with a clean context: the task text only.",
      "effect": "compute",
      "idempotent": false,
      "input_schema": {
        "additionalProperties": false,
        "description": "What the model passes: the task text.",
        "properties": {
          "task": {
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "title": "DelegateInput",
        "type": "object"
      },
      "late_schemas": [],
      "name": "Delegate"
    },
    "accept_case": {
      "description": "Make the state's case the one the user gave, after the user approved its changes.",
      "effect": "write",
      "idempotent": false,
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "title": "accept_case_input",
        "type": "object"
      },
      "late_schemas": [],
      "name": "accept_case"
    },
    "ask_economics": {
      "description": "Ask the user the ONE economics question from the rows you chose, and set what they approve.",
      "effect": "read",
      "idempotent": true,
      "input_schema": {
        "$defs": {
          "EconomicsValue": {
            "additionalProperties": false,
            "description": "One economics key with the value the case lead recommends and where it comes from.\n\n``key`` is the path under ``economics`` (``capex.heat_pump``, ``currency``); ``row`` the cost\ncatalogue's row ``id``, none for a value no row gives; ``others`` the key's other rows. Every\nfield but ``key`` takes null as left out (the run: ``others: null`` and ``source: null`` were\n21 errors and two more tries, #142); a value of null makes the key open, and a value needs its\nrow or its source.",
            "properties": {
              "key": {
                "title": "Key",
                "type": "string"
              },
              "others": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/OtherRow"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Others"
              },
              "row": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Row"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Source"
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Status"
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Unit"
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Url"
              },
              "value": {
                "default": null,
                "title": "Value"
              },
              "year": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Year"
              }
            },
            "required": [
              "key"
            ],
            "title": "EconomicsValue",
            "type": "object"
          },
          "OtherRow": {
            "additionalProperties": false,
            "description": "Another catalogue row of a key, shown beside the recommended one.",
            "properties": {
              "row": {
                "title": "Row",
                "type": "string"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Source"
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Unit"
              },
              "value": {
                "title": "Value"
              }
            },
            "required": [
              "row",
              "value"
            ],
            "title": "OtherRow",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Note"
          },
          "open": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Open"
          },
          "values": {
            "items": {
              "$ref": "#/$defs/EconomicsValue"
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "values"
        ],
        "title": "ask_economics_input",
        "type": "object"
      },
      "late_schemas": [],
      "name": "ask_economics"
    },
